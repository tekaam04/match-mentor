# Local Postgres from docker-compose.yml.
# In production (Neon via Vercel) DATABASE_URL is the pooled URL and DATABASE_URL_UNPOOLED the direct one,
# which migrations use.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matchmentor"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The site's public address, e.g. https://s2stigraymentors.com in production. Used in emails and sign-in links.
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional locally; the Google button is hidden when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email via Resend (optional locally; magic links are printed to the console when unset)
RESEND_API_KEY=""
# In production use an address on your verified Resend domain, e.g. "Match Mentor <hello@s2stigraymentors.com>"
EMAIL_FROM="Match Mentor <onboarding@resend.dev>"

# Comma-separated emails that become admins on first sign-in (and in the seed)
SEED_ADMIN_EMAILS=""
